{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(terraform apply*)",
      "Bash(terraform * apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform * destroy*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)"
    ]
  },
  "enabledPlugins": {
    "terraform@hashicorp": true,
    "terraform-skill@antonbabenko": true
  },
  "extraKnownMarketplaces": {
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    },
    "antonbabenko": {
      "source": {
        "source": "github",
        "repo": "antonbabenko/agent-plugins"
      }
    }
  }
}
